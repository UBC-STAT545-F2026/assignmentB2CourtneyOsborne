library(devtools)
document()
histogram <- function(data, category, bin_width = 1){
if(!is.numeric(pull(data, {{category}}))){
stop("category must be a numerical variable")
}
data %>%
ggplot(aes(x = {{category}})) +
geom_histogram(binwidth = bin_width)
}
document()
check()
